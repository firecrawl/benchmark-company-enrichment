# Company Enrichment benchmark: copy to .env and fill in only what you need.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# SCORING needs no key: the answer key, the industry grades and the metro table ship in company_enrichment/gt/.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# REPRODUCING A PUBLISHED ROW: only the provider you want to run. Every call spends that provider's credits.
# ---------------------------------------------------------------------------
# Apollo.io, FullEnrich and Data Legion, through Firecrawl Alexandria (one key for all three).
# Your Firecrawl team needs Alexandria enabled and each provider's terms accepted.
FIRECRAWL_API_KEY=<Firecrawl API key>
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# People Data Labs, Ocean.io and ContactOut are called through their own APIs, with your own key for each.
# People Data Labs company enrichment (1 credit per company matched)
PDL_API_KEY=<People Data Labs API key>
# Ocean.io company lookup (0.05 credits per company found)
OCEAN_API_KEY=<Ocean.io API token>
# ContactOut domain enrich (1 credit per company found)
CONTACTOUT_API_KEY=<ContactOut API token>

# ---------------------------------------------------------------------------
# GRADING NEW INDUSTRY LABELS (--judge): only when your provider returns a label nobody has graded yet.
# Two judges run on the Anthropic API, three on the Vercel AI Gateway. About $0.02 per label.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=<Anthropic API key>
# AI_GATEWAY_API_KEY=<Vercel AI Gateway key>

# ---------------------------------------------------------------------------
# YOUR OWN PROVIDER: the CLI flags --endpoint / --auth write these same values; set one or the other.
# ---------------------------------------------------------------------------
# CE_EXT_URL=https://api.yourco.com/enrich?domain={domain}
# CE_EXT_AUTH=Bearer <your key>
